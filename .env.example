# Discord Developer Portal
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Opcional: registra slash commands só nesse servidor (dev). Deixe vazio para registro global.
DISCORD_GUILD_ID=

# Transcrição — Groq (grátis, roda fora do servidor do bot).
# Crie uma conta e uma chave grátis em https://console.groq.com/keys
GROQ_API_KEY=
TRANSCRIBE_MODEL=whisper-large-v3-turbo
TRANSCRIBE_LANGUAGE=pt
# Tier grátis da Groq: 20 req/min pra Whisper. 18 é margem de segurança —
# suba se estiver num plano pago com limite maior.
TRANSCRIBE_RPM_LIMIT=18

# Captura de áudio
SILENCE_MS=1000
MIN_SEGMENT_MS=400
TRANSCRIBE_CONCURRENCY=3
MAX_SESSION_MINUTES=120
KEEP_AUDIO=false

# Fail-safe: desconecta o bot se ficar sozinho num canal por esse tempo.
# EMPTY_CHANNEL_POLICY decide o que fazer com gravação ativa (finish|cancel).
EMPTY_CHANNEL_TIMEOUT_MS=300000
EMPTY_CHANNEL_POLICY=finish

# Infra
DATA_DIR=./data
LOG_LEVEL=info
