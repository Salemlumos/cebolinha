# Discord Developer Portal
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Opcional: registra slash commands só nesse servidor (dev). Deixe vazio para registro global.
DISCORD_GUILD_ID=

# Transcrição:
#   groq   -> grátis, roda no serviço da Groq (não usa CPU do seu servidor).
#             Crie uma chave grátis em https://console.groq.com/keys
#   local  -> grátis, roda Whisper na própria máquina (offline, mais lento,
#             usa CPU/RAM do servidor do bot). Não precisa de chave.
#   openai -> pago, exige OPENAI_API_KEY.
TRANSCRIBER_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
# Nome do modelo depende do provider: groq usa "whisper-large-v3-turbo" ou
# "whisper-large-v3"; local usa "Xenova/whisper-base" (ou -tiny/-small);
# openai usa "whisper-1".
TRANSCRIBE_MODEL=whisper-large-v3-turbo
TRANSCRIBE_LANGUAGE=pt

# Captura de áudio
SILENCE_MS=1000
MIN_SEGMENT_MS=400
TRANSCRIBE_CONCURRENCY=3
MAX_SESSION_MINUTES=120
KEEP_AUDIO=false

# Infra
DATA_DIR=./data
LOG_LEVEL=info
