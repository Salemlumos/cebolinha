# Discord Developer Portal
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Opcional: registra slash commands só nesse servidor (dev). Deixe vazio para registro global.
DISCORD_GUILD_ID=

# Transcrição — "local" roda Whisper na própria máquina, grátis, sem
# chave de API (baixa o modelo uma vez e cacheia). Troque para "openai"
# só se quiser usar a API paga da OpenAI (exige OPENAI_API_KEY).
TRANSCRIBER_PROVIDER=local
OPENAI_API_KEY=
TRANSCRIBE_MODEL=Xenova/whisper-base
TRANSCRIBE_LANGUAGE=pt

# Captura de áudio
SILENCE_MS=1000
MIN_SEGMENT_MS=400
TRANSCRIBE_CONCURRENCY=3
MAX_SESSION_MINUTES=120
KEEP_AUDIO=false

# Infra
DATA_DIR=./data
LOG_LEVEL=info
